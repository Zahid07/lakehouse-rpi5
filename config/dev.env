env=dev

data_path=accel_data

catalog_path=:memory:

ducklake_catalog=ducklake:metadata.ducklake
ducklake_data_path=ducklake_data

raw_schema=raw
staging_schema=staging
curated_schema=curated
marts_schema=marts

sample_rate_hz=100
fft_max_bins=512

# DuckDB runtime tuning (RPi5 is memory constrained - see FFT OOM in notes)
duckdb_memory_limit=2GB
duckdb_threads=2
duckdb_preserve_insertion_order=false

# Batch sizing: raw parquet files per mini-batch
max_files_per_batch=10

# FFT windows (minutes) per SQL call - caps peak memory of the LIST/FFT step
fft_windows_per_chunk=60

# Realtime queue worker
ready_marker_name=_READY
worker_settle_seconds=60
worker_max_files_per_run=500
worker_max_retry_attempts=10
worker_retry_delay_seconds=120
