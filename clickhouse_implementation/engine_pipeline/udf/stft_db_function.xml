<!-- ClickHouse executable UDF: stft_db(Array(Float64)) -> Array(Float32).
     Installed to /etc/clickhouse-server/ by install_udf.sh; the script goes to
     ClickHouse's user_scripts directory. -->
<functions>
    <function>
        <type>executable_pool</type>          <!-- persistent processes: numpy is imported once -->
        <name>stft_db</name>
        <return_type>Array(Float32)</return_type>
        <argument>
            <type>Array(Float64)</type>
            <name>values</name>
        </argument>
        <format>RowBinary</format>            <!-- raw floats, no text parsing -->
        <command>stft_db.py</command>
        <send_chunk_header>1</send_chunk_header>
        <pool_size>2</pool_size>
        <max_command_execution_time>60</max_command_execution_time>
        <command_termination_timeout>10</command_termination_timeout>
    </function>
</functions>
